<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rv2aj_control</name>
  <version>0.1.0</version>
  <description>Serial driver, MoveIt-validated planner, voice control, translator, teach/loop sequencer and GUI for the Mitsubishi RV-2AJ (CR1-571).</description>
  <maintainer email="mehmet.robotik.tr@gmail.com">Mohamed Ossama ELIWA</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rv2aj_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>moveit_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <exec_depend>rv2aj_moveit_config</exec_depend>
  <exec_depend>rv2aj_description</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-pyaudio</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
